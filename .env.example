# Скопируй в .env или просто запусти `python run.py set-password` — он создаст .env сам.

# Хеш пароля админки (не сам пароль!). Создаётся командой set-password.
ADMIN_PASSWORD_HASH=

# Ключ подписи сессий. Создаётся командой set-password.
SECRET_KEY=

# База данных. По умолчанию SQLite в storage/site.db.
# MySQL на сервере: mysql+pymysql://user:password@localhost:3306/arch_site?charset=utf8mb4
# DATABASE_URL=

# Где хранить загруженные файлы и базу (по умолчанию ./storage)
# STORAGE_DIR=

# На сервере с HTTPS:
# COOKIE_SECURE=1
